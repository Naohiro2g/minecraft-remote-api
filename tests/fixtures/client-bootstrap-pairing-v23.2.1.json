            "id": 1,
            "error": {
              "code": -32000,
              "message": "auth required",
              "data": {
                "reason": "auth_required"
              }
            }
          }
        },
        {
          "op": "peer_eof"
        },
        {
          "op": "connect",
          "connection": "c2"
        },
        {
          "op": "client_send",
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "auth.pairBegin",
            "params": {
              "token_type": "session",
              "client": {
                "name": "fixture-client",
                "version": "2321.1.0",
                "locale": "ja"
              }
            }
          }
        },
        {
          "op": "peer_send",
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "pairing_id": "fixture-pairing",
              "pair_code": "123456",
              "expires_in": 120
            }
          }
        },
        {
          "op": "client_send",
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "auth.pairPoll",
            "params": {
              "pairing_id": "fixture-pairing"
            }
          }
        },
        {
          "op": "peer_send",
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "status": "pending"
            }
          }
        },
        {
          "op": "approve_pairing",
          "note": "fixtureのMinecraft内承認に相当。ネットワークmessageではない。"
        },
        {
          "op": "client_send",
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "auth.pairPoll",
            "params": {
              "pairing_id": "fixture-pairing"
            }
          }
        },
        {
          "op": "peer_send",
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": {
              "status": "ok",
              "token": "mcrs_fixture_only_not_a_real_credential"
            }
          }
        },
        {
          "op": "client_close"
        },
        {
