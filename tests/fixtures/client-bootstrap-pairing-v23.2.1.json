  "cases": [
    {
      "id": "F1-AU-01",
      "title": "auth_required→pending→承認→token付きhello",
      "basis": [
        {
          "path": "10-protocol/wire-format-design_ja.md",
          "section": "§6.5"
        },
        {
          "path": "10-protocol/wire-format-design_ja.md",
          "section": "§6.3"
        },
        {
          "path": "10-protocol/wire-format-design_ja.md",
          "section": "§7.3"
        }
      ],
      "steps": [
        {
          "op": "connect",
          "connection": "c1"
        },
        {
          "op": "client_send",
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "hello",
            "params": {
              "protocol": "23.2.1",
              "client": {
                "name": "fixture-client",
                "version": "2321.1.0",
                "locale": "ja"
              }
            }
          }
        },
        {
          "op": "peer_send",
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "error": {
              "code": -32000,
              "message": "auth required",
              "data": {
                "reason": "auth_required"
              }
            }
          }
        },
        {
          "op": "peer_eof"
        },
        {
          "op": "connect",
          "connection": "c2"
        },
        {
          "op": "client_send",
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "auth.pairBegin",
            "params": {
              "token_type": "session",
              "client": {
                "name": "fixture-client",
                "version": "2321.1.0",
                "locale": "ja"
              }
            }
          }
        },
        {
          "op": "peer_send",
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "pairing_id": "fixture-pairing",
              "pair_code": "123456",
              "expires_in": 120
            }
          }
        },
        {
          "op": "client_send",
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "auth.pairPoll",
            "params": {
              "pairing_id": "fixture-pairing"
            }
          }
        },
        {
          "op": "peer_send",
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "status": "pending"
            }
          }
        },
        {
          "op": "approve_pairing",
          "note": "fixtureのMinecraft内承認に相当。ネットワークmessageではない。"
        },
        {
          "op": "client_send",
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "auth.pairPoll",
            "params": {
              "pairing_id": "fixture-pairing"
            }
          }
        },
        {
          "op": "peer_send",
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": {
              "status": "ok",
              "token": "mcrs_fixture_only_not_a_real_credential"
            }
          }
        },
        {
          "op": "client_close"
        },
        {
          "op": "connect",
          "connection": "c3"
        },
        {
          "op": "client_send",
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "hello",
            "params": {
              "protocol": "23.2.1",
              "client": {
                "name": "fixture-client",
                "version": "2321.1.0",
                "locale": "ja"
              },
              "auth": {
                "token": "mcrs_fixture_only_not_a_real_credential"
              }
            }
          }
        },
        {
          "op": "peer_send",
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "protocol": "23.2.1",
              "mc_version": "1.21.11",
              "supported_mc_versions": ["1.21.11", "26.3"],
              "catalogHash": null,
              "world_constants": {
                "y_sea": 62
              },
              "session": "fixture-session",
              "player": "00000000-0000-4000-8000-000000000001",
              "dimension": "minecraft:overworld",
              "origin": [200, 0, 200],
              "permissions": {
                "online": true,
                "offline": false,
                "buildRange": 100
              },
              "server": "fixture-server"
            }
          }
        }
      ],
      "expected": {
        "token": "mcrs_fixture_only_not_a_real_credential",
        "result": {
          "protocol": "23.2.1",
          "mc_version": "1.21.11",
          "supported_mc_versions": ["1.21.11", "26.3"],
          "catalogHash": null,
          "world_constants": {
            "y_sea": 62
          },
