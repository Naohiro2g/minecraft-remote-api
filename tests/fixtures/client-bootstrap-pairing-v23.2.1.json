          "path": "10-protocol/wire-format-design_ja.md",
          "section": "§6.5"
        },
        {
          "path": "10-protocol/wire-format-design_ja.md",
          "section": "§6.3"
        },
        {
          "path": "10-protocol/wire-format-design_ja.md",
          "section": "§7.3"
        }
      ],
      "steps": [
        {
          "op": "connect",
          "connection": "c1"
        },
        {
          "op": "client_send",
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "hello",
            "params": {
              "protocol": "23.2.1",
              "client": {
                "name": "fixture-client",
                "version": "2321.1.0",
                "locale": "ja"
              }
