    {
      "id": "F1-HE-09",
      "title": "peerからprotocol_mismatch errorを受信",
      "basis": [
        {
          "path": "10-protocol/wire-format-design_ja.md",
          "section": "§6.1–6.4"
        },
        {
          "path": "10-protocol/versioning-design_ja.md",
          "section": "§8.2–8.3"
        },
        {
          "path": "10-protocol/wire-format-design_ja.md",
          "section": "§3.3–3.4"
        },
        {
          "path": "10-protocol/wire-format-design_ja.md",
          "section": "§7.3"
        }
      ],
      "steps": [
        {
          "op": "connect",
          "connection": "c1"
        },
        {
          "op": "client_send",
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "hello",
            "params": {
              "protocol": "24.0.0",
              "client": {
                "name": "fixture-client",
                "version": "2321.1.0",
                "locale": "ja"
              },
              "auth": {
                "token": "mcrs_fixture_only_not_a_real_credential"
              }
            }
          }
        },
        {
          "op": "peer_send",
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "error": {
              "code": -32000,
              "message": "Server protocol 23.2.1 cannot satisfy client protocol 24.0.0",
              "data": {
                "reason": "protocol_mismatch",
                "server": "23.2.1",
                "client_requires": "24.0.0"
              }
            }
          }
        },
        {
          "op": "peer_eof"
        }
      ],
      "expected": {
        "reason": "protocol_mismatch",
        "pending_ids": []
      },
      "unresolved": ["messageの正準文言・server定義域のcodeのexact番号・切断時機を、このfixtureで新しく固定しない。"]
    },
